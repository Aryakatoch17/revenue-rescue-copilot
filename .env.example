GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# cache = replay baked diagnoses (default; what judges should use)
# live  = call Groq (laptop bake only — do NOT set this on the public demo URL)
# rules = never call Groq
DIAGNOSIS_MODE=cache
LIVE_COPY=0
ALLOW_LIVE_LLM=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 0 = batch uses stub/cached links (recommended). Live proof still uses real links.
RAZORPAY_LIVE_BATCH=0
DATABASE_PATH=data/rescue.db
APPROVAL_THRESHOLD_INR=20000
MAX_ATTEMPTS=2
COOLDOWN_HOURS=2
